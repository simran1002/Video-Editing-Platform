# Database connection for Docker
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/video_editing_db?schema=public"

# Database connection for local development
# DATABASE_URL="postgresql://username:password@localhost:5432/video_editing_db?schema=public"

# Server configuration
PORT=3000
NODE_ENV=development

# Storage paths
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"

# FFmpeg path (optional, if not in PATH)
# FFMPEG_PATH="/usr/bin/ffmpeg"

# Redis (for Bull queue)
REDIS_HOST="redis"
REDIS_PORT=6379
